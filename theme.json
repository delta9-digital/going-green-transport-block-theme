		"custom": {
			"radius": {
				"xs": "6px",
				"sm": "8px",
				"md": "12px",
				"lg": "16px",
				"card": "20px",
				"panel": "24px",
				"pill": "999px"
			},
			"container": {
				"max": "1240px",
				"gutter": "24px"
			},
			"nav": {
				"height": "72px",
				"surface": "rgba(244, 245, 244, 0.9)",
				"blur": "8px"
			},
			"motion": {
				"ease": "cubic-bezier(0.2, 0, 0, 1)",
				"fast": "120ms",
				"base": "180ms",
				"slow": "320ms"
			},
			"tracking": {
				"tight": "-0.025em",
				"snug": "-0.02em",
				"caps": "0.12em",
				"mono": "0.1em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gray-50)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--container--gutter)",
				"right": "var(--wp--custom--container--gutter)",
				"top": "0",
				"bottom": "0"
			},
			"blockGap": "var(--wp--preset--spacing--60)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--green-900)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.05"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--page-title)",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"lineHeight": "1.02"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-md)",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-sm)",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.25"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lead)",
					"letterSpacing": "0",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--green-800)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--green-500)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--green-900)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--body)",
					"lineHeight": "1"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "20px",
						"right": "20px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--green-800)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--gray-600)"
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			}
		}
