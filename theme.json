		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 1px 2px rgba(20, 25, 20, 0.06), 0 1px 1px rgba(20, 25, 20, 0.04)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 4px 8px rgba(20, 25, 20, 0.08), 0 2px 4px rgba(20, 25, 20, 0.05)"
				},
				{
					"slug": "lg",
					"name": "Large",
					"shadow": "0 12px 24px rgba(20, 25, 20, 0.10), 0 4px 8px rgba(20, 25, 20, 0.06)"
				}
			]
